{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["docs/**", "README.md"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "DATABASE_URL",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_DEMO_USER_ID",
        "NEXT_PUBLIC_DEMO_USER_NAME",
        "NEXT_PUBLIC_DEMO_USER_ROLE",
        "NEXT_PUBLIC_DEMO_MANAGEMENT_ENABLED",
        "CAPYN_CONTACT_EMAIL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
