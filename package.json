{
  "name": "capyn",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "start": "node scripts/start-service.mjs",
    "dev": "turbo run dev --parallel --filter=@capyn/api --filter=@capyn/web",
    "dev:gate": "pnpm --filter @capyn/gate-service dev",
    "lint": "pnpm db:generate && eslint . --max-warnings=0",
    "security:audit": "pnpm audit --prod --audit-level high",
    "docs:check": "node scripts/check-docs.mjs",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck && tsc --noEmit -p examples/tsconfig.json",
    "check": "pnpm docs:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @capyn/database db:generate",
    "db:migrate": "pnpm --filter @capyn/database db:migrate",
    "db:seed": "pnpm --filter @capyn/database db:seed",
    "demo": "tsx --tsconfig examples/tsconfig.json examples/demo.ts",
    "smoke:production": "node scripts/smoke-production.mjs",
    "smoke:combined": "node scripts/smoke-combined.mjs",
    "video:render": "pnpm --filter @capyn/video render",
    "video:still": "pnpm --filter @capyn/video still",
    "video:studio": "pnpm --filter @capyn/video exec remotion studio src/index.ts",
    "media:screenshot": "node scripts/capture-dashboard.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@next/eslint-plugin-next": "15.5.2",
    "@types/node": "^24.3.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "tsx": "^4.20.5",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  }
}
