{
  "name": "@capyn/gate-service",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format esm --sourcemap --clean --external @prisma/client",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@capyn/database": "workspace:*",
    "@capyn/gate": "workspace:*",
    "@prisma/client": "^6.16.1",
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
