{
  "name": "@capyn/video",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "remotion bundle src/index.ts --out-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "render": "remotion render src/index.ts CapynPublicAlpha ../../outreach/video/capyn-public-alpha.mp4 --codec=h264 --crf=18",
    "still": "remotion still src/index.ts CapynPublicAlpha ../../outreach/video/capyn-public-alpha-cover.png --frame=630"
  },
  "dependencies": {
    "@fontsource-variable/geologica": "5.3.0",
    "@fontsource-variable/manrope": "^5.2.6",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@remotion/cli": "4.0.526",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.526",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
