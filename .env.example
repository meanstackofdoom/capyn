API_KEY_PEPPER=replace-with-at-least-32-random-characters
CAPYN_STORAGE=memory
PORT=4000
HOST=0.0.0.0
TRUST_PROXY=false
WEB_ORIGIN=http://localhost:3010
DEMO_HUMAN_AUTH=true
DEMO_HUMAN_USER_ID=usr_demo_owner
BOOTSTRAP_TOKEN=replace-with-a-random-bootstrap-token
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEMO_USER_ID=usr_demo_owner
NEXT_PUBLIC_DEMO_USER_NAME=Acme Owner
NEXT_PUBLIC_DEMO_USER_ROLE=Owner
NEXT_PUBLIC_DEMO_MANAGEMENT_ENABLED=true
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# The default local/mock path generates an ephemeral key and moves no value.
CAPYN_EXECUTION_MODE=local-mock

# Remote Gate control-plane configuration. Configure all values together and
# set CAPYN_EXECUTION_MODE=remote-gate. The private key is base64 PKCS#8 PEM.
# CAPYN_EXECUTION_GATE_URL=http://localhost:4100
# CAPYN_EXECUTION_GATE_CONTROL_TOKEN=replace-with-at-least-32-random-characters
# CAPYN_EXECUTION_GATE_ID=gate-aws-sandbox-1
# CAPYN_EXECUTION_PROVIDER_NAME=aws-ec2-dry-run
# CAPYN_EXECUTION_ISSUER=urn:capyn:control:local
# CAPYN_EXECUTION_AUDIENCE=urn:capyn:gate:aws-sandbox-1
# CAPYN_EXECUTION_KEY_ID=execution-key-2026-08
# CAPYN_EXECUTION_PRIVATE_KEY_B64=base64-encoded-pkcs8-p256-private-key
# CAPYN_EXECUTION_GATE_RECEIPT_VERIFY_SECRET_B64=base64-encoded-shared-hmac-secret
# CAPYN_EXECUTION_CLAIM_TTL_SECONDS=30
# CAPYN_EXECUTION_GATE_TIMEOUT_MS=10000

# Optional stale-execution reconciliation sweep. The worker issues RECONCILE
# claims only for PENDING executions whose lease has expired; it never re-EXECUTEs.
# CAPYN_EXECUTION_SWEEP_ENABLED=true
# CAPYN_EXECUTION_SWEEP_INTERVAL_MS=60000

# Separate Gate service configuration. GATE_PUBLIC_KEYS_B64 is a base64 JSON
# object mapping key IDs to P-256 SPKI public PEMs. The AWS blueprint value is
# a base64 JSON array; the shipped adapter only validates DRY_RUN requests and
# never loads AWS credentials or calls RunInstances.
# GATE_REPLAY_STORAGE=postgres
# GATE_CONTROL_TOKEN=the-same-control-channel-secret-as-the-api
# GATE_ID=gate-aws-sandbox-1
# GATE_EXPECTED_ISSUER=urn:capyn:control:local
# GATE_AUDIENCE=urn:capyn:gate:aws-sandbox-1
# GATE_PUBLIC_KEYS_B64=base64-encoded-key-id-to-public-pem-json
# GATE_RECEIPT_SIGNING_SECRET_B64=base64-encoded-shared-hmac-secret
# GATE_ALLOWED_CLOCK_SKEW_SECONDS=5
# GATE_MAX_CLAIM_TTL_SECONDS=60
# AWS_SANDBOX_BLUEPRINTS_B64=base64-encoded-fixed-blueprint-array

# Optional owner-approved address shown by the browser-local private brief flow.
# CAPYN_CONTACT_EMAIL=briefs@example.com

# Optional private project-status page. Keep both values server-side and out of Git.
# PROJECT_STATUS_PASSWORD=replace-with-a-strong-private-page-password
# PROJECT_STATUS_SESSION_SECRET=replace-with-at-least-32-random-characters
# PROJECT_STATUS_CONTENT_B64=base64-encoded-private-markdown

# Optional PostgreSQL adapter. Set CAPYN_STORAGE=postgres when a database is provisioned.
DATABASE_URL=postgresql://capyn:capyn@localhost:5432/capyn?schema=public
# CAPYN_SEED_DEMO=true

# Optional single-service persistent volume adapter.
# CAPYN_STORAGE=volume
# CAPYN_VOLUME_PATH=/data/capyn/capyn-state.v8

# Optional hosted billing. Uncomment and configure all four together.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_TEAM_MONTHLY=price_...
# STRIPE_PRICE_BUSINESS_MONTHLY=price_...
