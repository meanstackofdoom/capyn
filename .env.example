API_KEY_PEPPER=replace-with-at-least-32-random-characters
CAPYN_STORAGE=memory
PORT=4000
HOST=0.0.0.0
TRUST_PROXY=false
WEB_ORIGIN=http://localhost:3010
DEMO_HUMAN_AUTH=true
DEMO_HUMAN_USER_ID=usr_demo_owner
BOOTSTRAP_TOKEN=replace-with-a-random-bootstrap-token
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEMO_USER_ID=usr_demo_owner
NEXT_PUBLIC_DEMO_USER_NAME=Acme Owner
NEXT_PUBLIC_DEMO_USER_ROLE=Owner
NEXT_PUBLIC_DEMO_MANAGEMENT_ENABLED=true
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# Optional private project-status page. Keep both values server-side and out of Git.
# PROJECT_STATUS_PASSWORD=replace-with-a-strong-private-page-password
# PROJECT_STATUS_SESSION_SECRET=replace-with-at-least-32-random-characters
# PROJECT_STATUS_CONTENT_B64=base64-encoded-private-markdown

# Optional PostgreSQL adapter. Set CAPYN_STORAGE=postgres when a database is provisioned.
DATABASE_URL=postgresql://capyn:capyn@localhost:5432/capyn?schema=public

# Optional hosted billing. Uncomment and configure all four together.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_TEAM_MONTHLY=price_...
# STRIPE_PRICE_BUSINESS_MONTHLY=price_...
