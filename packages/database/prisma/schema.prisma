generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  APPROVER
  VIEWER
}

enum AgentStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum MandateStatus {
  DRAFT
  ACTIVE
  REVOKED
  EXPIRED
}

enum AuthorizationDecision {
  ALLOW
  DENY
  REQUIRE_APPROVAL
}

enum AuthorizationState {
  REQUESTED
  ALLOWED
  DENIED
  AWAITING_APPROVAL
  APPROVED
  REJECTED
  EXECUTING
  EXECUTED
  FAILED
  EXPIRED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum ExecutionStatus {
  PENDING
  EXECUTED
  FAILED
}

enum ActorType {
  USER
  AGENT
  SYSTEM
}

enum BillingPlan {
  DEVELOPER
  TEAM
  BUSINESS
  ENTERPRISE
  DESIGN_PARTNER
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
  PAUSED
}

enum BillingProviderName {
  INTERNAL
  MANUAL
  STRIPE
}

enum BillableMetric {
  AUTHORIZATION_DECISION
  APPROVAL_REQUEST
  ACTIVE_AGENT
  AUDIT_EVENT
  INTEGRATION_CONNECTION
}

model Organisation {
  id             String          @id @db.VarChar(40)
  name           String          @db.VarChar(160)
  slug           String          @unique @db.VarChar(100)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  users          User[]
  agents         Agent[]
  mandates       Mandate[]
  authorizations Authorization[]
  auditEvents    AuditEvent[]
  subscription   OrganisationSubscription?
  billingUsageEvents BillingUsageEvent[]
  productionLaunch ProductionLaunch?

  @@map("organisations")
}

model OrganisationSubscription {
  id                     String              @id @db.VarChar(40)
  organisationId         String              @unique @map("organisation_id") @db.VarChar(40)
  plan                   BillingPlan         @default(DEVELOPER)
  status                 SubscriptionStatus  @default(ACTIVE)
  provider               BillingProviderName @default(INTERNAL)
  providerCustomerId     String?             @unique @map("provider_customer_id") @db.VarChar(255)
  providerSubscriptionId String?             @unique @map("provider_subscription_id") @db.VarChar(255)
  currentPeriodStart     DateTime            @map("current_period_start")
  currentPeriodEnd       DateTime            @map("current_period_end")
  cancelAtPeriodEnd      Boolean             @default(false) @map("cancel_at_period_end")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")
  organisation           Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([plan, status])
  @@map("organisation_subscriptions")
}

model BillingUsageEvent {
  id                 String         @id @db.VarChar(40)
  organisationId     String         @map("organisation_id") @db.VarChar(40)
  metric             BillableMetric
  quantity           BigInt
  sourceType         String         @map("source_type") @db.VarChar(80)
  sourceId           String         @map("source_id") @db.VarChar(80)
  occurredAt         DateTime       @default(now()) @map("occurred_at")
  providerReportedAt DateTime?      @map("provider_reported_at")
  metadata           Json
  organisation       Organisation   @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@unique([organisationId, metric, sourceType, sourceId])
  @@index([organisationId, metric, occurredAt])
  @@map("billing_usage_events")
}

model BillingWebhookEvent {
  id              String              @id @db.VarChar(40)
  provider        BillingProviderName
  providerEventId String              @map("provider_event_id") @db.VarChar(255)
  eventType       String              @map("event_type") @db.VarChar(160)
  payloadHash     String              @map("payload_hash") @db.Char(64)
  receivedAt      DateTime            @default(now()) @map("received_at")
  processedAt     DateTime?           @map("processed_at")

  @@unique([provider, providerEventId])
  @@index([provider, receivedAt])
  @@map("billing_webhook_events")
}

model User {
  id             String            @id @db.VarChar(40)
  organisationId String            @map("organisation_id") @db.VarChar(40)
  name           String            @db.VarChar(160)
  email          String            @db.VarChar(320)
  role           UserRole
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  organisation   Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  createdMandates Mandate[]        @relation("MandateCreator")
  approvalDecisions ApprovalRequest[] @relation("ApprovalDecider")
  credentials     UserCredential[]
  productionLaunch ProductionLaunch? @relation("ProductionLaunchOwner")

  @@unique([organisationId, email])
  @@index([organisationId, role])
  @@map("users")
}

model Agent {
  id             String          @id @db.VarChar(40)
  organisationId String          @map("organisation_id") @db.VarChar(40)
  name           String          @db.VarChar(160)
  slug           String          @db.VarChar(100)
  description    String?         @db.VarChar(500)
  status         AgentStatus     @default(ACTIVE)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  credentials    AgentCredential[]
  mandates       Mandate[]
  authorizations Authorization[]
  productionLaunch ProductionLaunch?

  @@unique([organisationId, slug])
  @@index([organisationId, status])
  @@map("agents")
}

model AgentCredential {
  id                     String            @id @db.VarChar(40)
  agentId                String            @map("agent_id") @db.VarChar(40)
  keyPrefix              String            @map("key_prefix") @db.VarChar(32)
  keyHash                String            @unique @map("key_hash") @db.Char(64)
  rotationIdempotencyKey String?           @map("rotation_idempotency_key") @db.VarChar(200)
  rotatedFromId          String?           @map("rotated_from_id") @db.VarChar(40)
  createdAt              DateTime          @default(now()) @map("created_at")
  lastUsedAt             DateTime?         @map("last_used_at")
  revokedAt              DateTime?         @map("revoked_at")
  agent                  Agent             @relation(fields: [agentId], references: [id], onDelete: Restrict)
  rotatedFrom            AgentCredential?  @relation("CredentialRotations", fields: [rotatedFromId], references: [id], onDelete: Restrict)
  rotations              AgentCredential[] @relation("CredentialRotations")
  productionLaunch       ProductionLaunch?

  @@unique([agentId, rotationIdempotencyKey])
  @@index([agentId, revokedAt])
  @@index([rotatedFromId])
  @@map("agent_credentials")
}

model UserCredential {
  id               String            @id @db.VarChar(40)
  userId           String            @map("user_id") @db.VarChar(40)
  keyPrefix        String            @map("key_prefix") @db.VarChar(32)
  keyHash          String            @unique @map("key_hash") @db.Char(64)
  createdAt        DateTime          @default(now()) @map("created_at")
  lastUsedAt       DateTime?         @map("last_used_at")
  revokedAt        DateTime?         @map("revoked_at")
  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  productionLaunch ProductionLaunch?

  @@index([userId, revokedAt])
  @@map("user_credentials")
}

model Mandate {
  id             String           @id @db.VarChar(40)
  organisationId String           @map("organisation_id") @db.VarChar(40)
  agentId        String           @map("agent_id") @db.VarChar(40)
  name           String           @db.VarChar(160)
  version        Int
  status         MandateStatus    @default(DRAFT)
  validFrom      DateTime         @map("valid_from")
  validUntil     DateTime         @map("valid_until")
  createdBy      String           @map("created_by") @db.VarChar(40)
  createdAt      DateTime         @default(now()) @map("created_at")
  revokedAt      DateTime?        @map("revoked_at")
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  agent          Agent            @relation(fields: [agentId], references: [id], onDelete: Restrict)
  creator        User             @relation("MandateCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  capabilities   MandateCapability[]
  spendingPolicy SpendingPolicy?
  authorizations Authorization[]
  productionLaunch ProductionLaunch?

  @@unique([agentId, name, version])
  @@index([organisationId, status])
  @@index([agentId, status, validFrom, validUntil])
  @@map("mandates")
}

model ProductionLaunch {
  id                    String          @id @db.VarChar(40)
  sandboxCredentialHash String          @unique @map("sandbox_credential_hash") @db.Char(64)
  idempotencyKey        String          @map("idempotency_key") @db.VarChar(200)
  requestHash           String          @map("request_hash") @db.Char(64)
  organisationId        String          @unique @map("organisation_id") @db.VarChar(40)
  ownerId               String          @unique @map("owner_id") @db.VarChar(40)
  agentId               String          @unique @map("agent_id") @db.VarChar(40)
  mandateId             String          @unique @map("mandate_id") @db.VarChar(40)
  ownerCredentialId     String          @unique @map("owner_credential_id") @db.VarChar(40)
  agentCredentialId     String          @unique @map("agent_credential_id") @db.VarChar(40)
  mandateValidUntil     DateTime        @map("mandate_valid_until")
  planIntent            BillingPlan     @map("plan_intent")
  createdAt             DateTime        @default(now()) @map("created_at")
  organisation          Organisation    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  owner                 User            @relation("ProductionLaunchOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  agent                 Agent           @relation(fields: [agentId], references: [id], onDelete: Restrict)
  mandate               Mandate         @relation(fields: [mandateId], references: [id], onDelete: Restrict)
  ownerCredential       UserCredential  @relation(fields: [ownerCredentialId], references: [id], onDelete: Restrict)
  agentCredential       AgentCredential @relation(fields: [agentCredentialId], references: [id], onDelete: Restrict)

  @@index([planIntent, createdAt])
  @@index([idempotencyKey])
  @@map("production_launches")
}

model MandateCapability {
  mandateId String   @map("mandate_id") @db.VarChar(40)
  capability String  @db.VarChar(100)
  mandate   Mandate  @relation(fields: [mandateId], references: [id], onDelete: Restrict)

  @@id([mandateId, capability])
  @@map("mandate_capabilities")
}

model SpendingPolicy {
  id                       String   @id @db.VarChar(40)
  mandateId                String   @unique @map("mandate_id") @db.VarChar(40)
  currency                 String   @db.Char(3)
  allowedVendors           Json     @map("allowed_vendors")
  perTransactionLimitMinor BigInt   @map("per_transaction_limit_minor")
  dailyLimitMinor          BigInt   @map("daily_limit_minor")
  monthlyLimitMinor        BigInt   @map("monthly_limit_minor")
  approvalThresholdMinor   BigInt   @map("approval_threshold_minor")
  mandate                  Mandate  @relation(fields: [mandateId], references: [id], onDelete: Restrict)

  @@map("spending_policies")
}

model Authorization {
  id                String                 @id @db.VarChar(40)
  organisationId    String                 @map("organisation_id") @db.VarChar(40)
  agentId           String                 @map("agent_id") @db.VarChar(40)
  mandateId         String?                @map("mandate_id") @db.VarChar(40)
  idempotencyKey    String                 @map("idempotency_key") @db.VarChar(200)
  requestHash       String                 @map("request_hash") @db.Char(64)
  capability        String                 @db.VarChar(100)
  amountMinor       BigInt                 @map("amount_minor")
  currency          String                 @db.Char(3)
  vendorId          String                 @map("vendor_id") @db.VarChar(100)
  vendorName        String?                @map("vendor_name") @db.VarChar(160)
  metadata          Json
  decision          AuthorizationDecision
  state             AuthorizationState
  reasonCodes       Json                   @map("reason_codes")
  evaluationTrace   Json                   @map("evaluation_trace")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  expiresAt         DateTime?              @map("expires_at")
  organisation      Organisation           @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  agent             Agent                  @relation(fields: [agentId], references: [id], onDelete: Restrict)
  mandate           Mandate?               @relation(fields: [mandateId], references: [id], onDelete: Restrict)
  approval          ApprovalRequest?
  execution         Execution?

  @@unique([agentId, idempotencyKey])
  @@index([organisationId, createdAt(sort: Desc)])
  @@index([agentId, currency, state, createdAt])
  @@map("authorizations")
}

model ApprovalRequest {
  id              String         @id @db.VarChar(40)
  organisationId  String         @map("organisation_id") @db.VarChar(40)
  authorizationId String         @unique @map("authorization_id") @db.VarChar(40)
  status          ApprovalStatus @default(PENDING)
  triggeredBy     String         @map("triggered_by") @db.VarChar(100)
  requestedAt     DateTime       @default(now()) @map("requested_at")
  decidedAt       DateTime?      @map("decided_at")
  decidedBy       String?        @map("decided_by") @db.VarChar(40)
  comment         String?        @db.VarChar(500)
  authorization   Authorization  @relation(fields: [authorizationId], references: [id], onDelete: Restrict)
  decider         User?          @relation("ApprovalDecider", fields: [decidedBy], references: [id], onDelete: Restrict)

  @@index([organisationId, status, requestedAt])
  @@map("approval_requests")
}

model Execution {
  id                String          @id @db.VarChar(40)
  organisationId    String          @map("organisation_id") @db.VarChar(40)
  authorizationId   String          @unique @map("authorization_id") @db.VarChar(40)
  status            ExecutionStatus @default(PENDING)
  provider          String          @db.VarChar(80)
  externalReference String?         @map("external_reference") @db.VarChar(200)
  errorCode         String?         @map("error_code") @db.VarChar(100)
  attemptCount      Int             @default(1) @map("attempt_count")
  lastAttemptAt     DateTime        @default(now()) @map("last_attempt_at")
  leaseExpiresAt    DateTime?       @map("lease_expires_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  completedAt       DateTime?       @map("completed_at")
  authorization     Authorization   @relation(fields: [authorizationId], references: [id], onDelete: Restrict)

  @@index([organisationId, createdAt(sort: Desc)])
  @@index([status, leaseExpiresAt])
  @@map("executions")
}

model AuditEvent {
  id             String       @id @db.VarChar(40)
  organisationId String       @map("organisation_id") @db.VarChar(40)
  actorType      ActorType    @map("actor_type")
  actorId        String?      @map("actor_id") @db.VarChar(40)
  eventType      String       @map("event_type") @db.VarChar(100)
  entityType     String       @map("entity_type") @db.VarChar(100)
  entityId       String       @map("entity_id") @db.VarChar(40)
  timestamp      DateTime     @default(now())
  metadata       Json
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([organisationId, timestamp(sort: Desc)])
  @@index([organisationId, eventType, timestamp(sort: Desc)])
  @@map("audit_events")
}
