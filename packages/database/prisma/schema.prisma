generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  APPROVER
  VIEWER
}

enum AgentStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum MandateStatus {
  DRAFT
  ACTIVE
  REVOKED
  EXPIRED
}

enum AuthorizationDecision {
  ALLOW
  DENY
  REQUIRE_APPROVAL
}

enum AuthorizationState {
  REQUESTED
  ALLOWED
  DENIED
  AWAITING_APPROVAL
  APPROVED
  REJECTED
  EXECUTING
  EXECUTED
  FAILED
  EXPIRED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum ExecutionStatus {
  PENDING
  EXECUTED
  FAILED
}

enum ActorType {
  USER
  AGENT
  SYSTEM
}

model Organisation {
  id             String          @id @db.VarChar(40)
  name           String          @db.VarChar(160)
  slug           String          @unique @db.VarChar(100)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  users          User[]
  agents         Agent[]
  mandates       Mandate[]
  authorizations Authorization[]
  auditEvents    AuditEvent[]

  @@map("organisations")
}

model User {
  id             String            @id @db.VarChar(40)
  organisationId String            @map("organisation_id") @db.VarChar(40)
  name           String            @db.VarChar(160)
  email          String            @db.VarChar(320)
  role           UserRole
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  organisation   Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  createdMandates Mandate[]        @relation("MandateCreator")
  approvalDecisions ApprovalRequest[] @relation("ApprovalDecider")

  @@unique([organisationId, email])
  @@index([organisationId, role])
  @@map("users")
}

model Agent {
  id             String          @id @db.VarChar(40)
  organisationId String          @map("organisation_id") @db.VarChar(40)
  name           String          @db.VarChar(160)
  slug           String          @db.VarChar(100)
  description    String?         @db.VarChar(500)
  status         AgentStatus     @default(ACTIVE)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  credentials    AgentCredential[]
  mandates       Mandate[]
  authorizations Authorization[]

  @@unique([organisationId, slug])
  @@index([organisationId, status])
  @@map("agents")
}

model AgentCredential {
  id         String    @id @db.VarChar(40)
  agentId    String    @map("agent_id") @db.VarChar(40)
  keyPrefix  String    @map("key_prefix") @db.VarChar(32)
  keyHash    String    @unique @map("key_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  agent      Agent     @relation(fields: [agentId], references: [id], onDelete: Restrict)

  @@index([agentId, revokedAt])
  @@map("agent_credentials")
}

model Mandate {
  id             String           @id @db.VarChar(40)
  organisationId String           @map("organisation_id") @db.VarChar(40)
  agentId        String           @map("agent_id") @db.VarChar(40)
  name           String           @db.VarChar(160)
  version        Int
  status         MandateStatus    @default(DRAFT)
  validFrom      DateTime         @map("valid_from")
  validUntil     DateTime         @map("valid_until")
  createdBy      String           @map("created_by") @db.VarChar(40)
  createdAt      DateTime         @default(now()) @map("created_at")
  revokedAt      DateTime?        @map("revoked_at")
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  agent          Agent            @relation(fields: [agentId], references: [id], onDelete: Restrict)
  creator        User             @relation("MandateCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  capabilities   MandateCapability[]
  spendingPolicy SpendingPolicy?
  authorizations Authorization[]

  @@unique([agentId, name, version])
  @@index([organisationId, status])
  @@index([agentId, status, validFrom, validUntil])
  @@map("mandates")
}

model MandateCapability {
  mandateId String   @map("mandate_id") @db.VarChar(40)
  capability String  @db.VarChar(100)
  mandate   Mandate  @relation(fields: [mandateId], references: [id], onDelete: Restrict)

  @@id([mandateId, capability])
  @@map("mandate_capabilities")
}

model SpendingPolicy {
  id                       String   @id @db.VarChar(40)
  mandateId                String   @unique @map("mandate_id") @db.VarChar(40)
  currency                 String   @db.Char(3)
  allowedVendors           Json     @map("allowed_vendors")
  perTransactionLimitMinor BigInt   @map("per_transaction_limit_minor")
  dailyLimitMinor          BigInt   @map("daily_limit_minor")
  monthlyLimitMinor        BigInt   @map("monthly_limit_minor")
  approvalThresholdMinor   BigInt   @map("approval_threshold_minor")
  mandate                  Mandate  @relation(fields: [mandateId], references: [id], onDelete: Restrict)

  @@map("spending_policies")
}

model Authorization {
  id                String                 @id @db.VarChar(40)
  organisationId    String                 @map("organisation_id") @db.VarChar(40)
  agentId           String                 @map("agent_id") @db.VarChar(40)
  mandateId         String?                @map("mandate_id") @db.VarChar(40)
  idempotencyKey    String                 @map("idempotency_key") @db.VarChar(200)
  requestHash       String                 @map("request_hash") @db.Char(64)
  capability        String                 @db.VarChar(100)
  amountMinor       BigInt                 @map("amount_minor")
  currency          String                 @db.Char(3)
  vendorId          String                 @map("vendor_id") @db.VarChar(100)
  vendorName        String?                @map("vendor_name") @db.VarChar(160)
  metadata          Json
  decision          AuthorizationDecision
  state             AuthorizationState
  reasonCodes       Json                   @map("reason_codes")
  evaluationTrace   Json                   @map("evaluation_trace")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  expiresAt         DateTime?              @map("expires_at")
  organisation      Organisation           @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  agent             Agent                  @relation(fields: [agentId], references: [id], onDelete: Restrict)
  mandate           Mandate?               @relation(fields: [mandateId], references: [id], onDelete: Restrict)
  approval          ApprovalRequest?
  execution         Execution?

  @@unique([agentId, idempotencyKey])
  @@index([organisationId, createdAt(sort: Desc)])
  @@index([agentId, currency, state, createdAt])
  @@map("authorizations")
}

model ApprovalRequest {
  id              String         @id @db.VarChar(40)
  organisationId  String         @map("organisation_id") @db.VarChar(40)
  authorizationId String         @unique @map("authorization_id") @db.VarChar(40)
  status          ApprovalStatus @default(PENDING)
  triggeredBy     String         @map("triggered_by") @db.VarChar(100)
  requestedAt     DateTime       @default(now()) @map("requested_at")
  decidedAt       DateTime?      @map("decided_at")
  decidedBy       String?        @map("decided_by") @db.VarChar(40)
  comment         String?        @db.VarChar(500)
  authorization   Authorization  @relation(fields: [authorizationId], references: [id], onDelete: Restrict)
  decider         User?          @relation("ApprovalDecider", fields: [decidedBy], references: [id], onDelete: Restrict)

  @@index([organisationId, status, requestedAt])
  @@map("approval_requests")
}

model Execution {
  id                String          @id @db.VarChar(40)
  organisationId    String          @map("organisation_id") @db.VarChar(40)
  authorizationId   String          @unique @map("authorization_id") @db.VarChar(40)
  status            ExecutionStatus @default(PENDING)
  provider          String          @db.VarChar(80)
  externalReference String?         @map("external_reference") @db.VarChar(200)
  errorCode         String?         @map("error_code") @db.VarChar(100)
  createdAt         DateTime        @default(now()) @map("created_at")
  completedAt       DateTime?       @map("completed_at")
  authorization     Authorization   @relation(fields: [authorizationId], references: [id], onDelete: Restrict)

  @@index([organisationId, createdAt(sort: Desc)])
  @@map("executions")
}

model AuditEvent {
  id             String       @id @db.VarChar(40)
  organisationId String       @map("organisation_id") @db.VarChar(40)
  actorType      ActorType    @map("actor_type")
  actorId        String?      @map("actor_id") @db.VarChar(40)
  eventType      String       @map("event_type") @db.VarChar(100)
  entityType     String       @map("entity_type") @db.VarChar(100)
  entityId       String       @map("entity_id") @db.VarChar(40)
  timestamp      DateTime     @default(now())
  metadata       Json
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([organisationId, timestamp(sort: Desc)])
  @@index([organisationId, eventType, timestamp(sort: Desc)])
  @@map("audit_events")
}
