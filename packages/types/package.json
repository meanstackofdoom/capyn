{
  "name": "@capyn/types",
  "version": "0.4.0",
  "description": "Shared schemas and authority contracts for CAPYN.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meanstackofdoom/capyn.git",
    "directory": "packages/types"
  },
  "homepage": "https://capyn-production.up.railway.app/developers",
  "bugs": {
    "url": "https://github.com/meanstackofdoom/capyn/issues"
  },
  "keywords": ["ai-agents", "authorization", "policy", "typescript", "capyn"],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
